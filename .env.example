# OBLIGATORIO:

# Copiar este archivo como .env y completar los valores. El archivo .env no se versiona.
# Lo leen docker compose y la aplicación (spring.config.import en application.yaml).
# Los valores van sin comillas: la aplicación toma las comillas como parte del valor.
TURNOS_DB_NAME=turnos
TURNOS_DB_USER=turnos
TURNOS_DB_PASSWORD=
TURNOS_DB_PORT=5432

# Clave privada RSA que firma el JWT de los usuarios.
TURNOS_JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem

# OBLIGATORIAS PARA EL SISTEMA COMPLETO:

# Servicio de catálogo. Vacía: el servicio arranca con un warning y la consulta de turnos responde 503.
TURNOS_CATALOG_BASE_URL=

# Cuenta técnica de la cátedra (X01). Completar con los datos reales; si falta alguno, el servicio arranca
# con un warning y sin integración con la cátedra. Nunca subir estos valores al repositorio.
TURNOS_CATEDRA_BASE_URL=
TURNOS_CATEDRA_USERNAME=
TURNOS_CATEDRA_PASSWORD=

# Solo con Docker Compose. TURNOS_PORT: el puerto de la app en tu máquina; cambialo si el 8080 está ocupado.
# TURNOS_CATALOG_DOCKER_URL: dónde busca el contenedor al catálogo; el valor por defecto sirve para el sistema
# completo. TURNOS_CATALOG_BASE_URL sigue siendo la que usa la app con ./mvnw.
# TURNOS_PORT=8080
# TURNOS_CATALOG_DOCKER_URL=http://catalog-service:8080

# Solo con Docker Compose en Linux, si tu usuario no es el 1000 (comprobalo con `id -u` y `id -g`): sin estas dos,
# la app no puede leer la clave del JWT y no arranca. En Mac y Windows no hacen falta.
# TURNOS_UID=1000
# TURNOS_GID=1000

---------------------------------------

# OPCIONALES, EL VALOR QUE ESTA ESTABLECIDO DE EJEMPLO ES EL VALOR POR DEFECTO.

# Opcional: segundos que se espera una respuesta de Postgres antes de dar la operación por fallida. También limita a las migraciones de Flyway. 0 quita el límite. Si se define, no puede quedar vacía: la aplicación no arranca.
# TURNOS_DB_SOCKET_TIMEOUT=30

# Opcional: Vigencia del JWT. Formato de duración de Spring: 30m, 12h, 1d.
TURNOS_JWT_TOKEN_VALIDITY=24h

# Opcionales: tiempos y reintentos. Duraciones con el formato de Spring. Si queda vacía, rige el valor por defecto.
# TURNOS_CATALOG_CONNECT_TIMEOUT=2s
# TURNOS_CATALOG_READ_TIMEOUT=3s
# TURNOS_CATALOG_MAX_ATTEMPTS=3
# TURNOS_CATALOG_INITIAL_DELAY=500ms
# TURNOS_CATALOG_DELAY_MULTIPLIER=2
# TURNOS_CATEDRA_OPERATIONS_CONNECT_TIMEOUT=2s
# TURNOS_CATEDRA_OPERATIONS_READ_TIMEOUT=3s
# TURNOS_CATEDRA_OPERATIONS_MAX_ATTEMPTS=3
# TURNOS_CATEDRA_OPERATIONS_INITIAL_DELAY=500ms
# TURNOS_CATEDRA_OPERATIONS_DELAY_MULTIPLIER=2
# TURNOS_CATEDRA_OPERATIONS_INITIAL_LOGIN_WAIT=2m

# Opcionales: Kafka de la cátedra. Los servidores, los topics y el consumer group llegan con el login técnico.
# ENABLED=false deja al servicio sin consumir. El Kafka de la cátedra no pide credenciales (PLAINTEXT); si las pidiera,
# se usan las de la cuenta técnica con el protocolo y el mecanismo indicados. RETRY: reintentos al procesar un mensaje.
# TURNOS_CATEDRA_KAFKA_ENABLED=true
# TURNOS_CATEDRA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# TURNOS_CATEDRA_KAFKA_SASL_MECHANISM=PLAIN
# TURNOS_CATEDRA_KAFKA_RETRY_INITIAL_DELAY=500ms
# TURNOS_CATEDRA_KAFKA_RETRY_MULTIPLIER=2
# TURNOS_CATEDRA_KAFKA_RETRY_MAX_ATTEMPTS=3
# TURNOS_CATEDRA_KAFKA_RETRY_PAUSE=30s

# Opcional: PUBLISH: publicar mientras un usuario espera la respuesta; TIMEOUT es el tope de todos los intentos juntos.
# TURNOS_CATEDRA_KAFKA_PUBLISH_TIMEOUT=10s
# TURNOS_CATEDRA_KAFKA_PUBLISH_ATTEMPT_TIMEOUT=2500ms
# TURNOS_CATEDRA_KAFKA_PUBLISH_MAX_ATTEMPTS=3
# TURNOS_CATEDRA_KAFKA_PUBLISH_INITIAL_DELAY=500ms
# TURNOS_CATEDRA_KAFKA_PUBLISH_MULTIPLIER=2

# Opcionales: zona de atención (define "hoy" y qué turnos ya pasaron) y antigüedad máxima del caché de ocupaciones.
# TURNOS_ATTENTION_ZONE=America/Argentina/Mendoza
# TURNOS_OCCUPANCY_CACHE_MAX_AGE=60m

# Opcional: cuánto se espera después del vencimiento de un hold antes de dar el proceso de reserva por vencido.
# TURNOS_RESERVATION_SAFETY_MARGIN=30s

# Opcional: cuánto se espera entre un barrido de procesos vencidos y el siguiente, como 1m, 90s o PT1M (un número solo son
# milisegundos). Vacío, 0, negativo o mal escrito: la aplicación no arranca.
# TURNOS_RESERVATION_SWEEP_INTERVAL=1m

# Opcional: enciende o apaga ese barrido. Vacía, lo apaga.
# TURNOS_RESERVATION_SWEEP_ENABLED=true

# Opcional: cuánto se espera entre un ciclo de reconciliación con la cátedra y el siguiente, con el mismo formato y las
# mismas reglas que el intervalo del barrido.
# TURNOS_RESERVATION_RECONCILIATION_INTERVAL=1m

# Opcional: enciende o apaga la reconciliación. Vacía, la apaga.
# TURNOS_RESERVATION_RECONCILIATION_ENABLED=true

# Opcional: Orígenes de navegador que pueden usar la API (CORS), separados por comas, por ejemplo http://localhost:3000.
# Vacío: ningún navegador. La app Android no lo necesita. No usar *
TURNOS_CORS_ALLOWED_ORIGINS=

# OBLIGATORIO PARA EL TEST E2E
# Solo para la suite E2E (./mvnw test -Pe2e), la aplicación no la lee: consumer group con el que el E2E lee el pedido
# de teléfono de la cátedra real. Tiene que terminar en -e2e y no ser el del servicio, por ejemplo el sugerido por el
# login técnico con -e2e al final. Vacía, los E2E no consumen de Kafka.
# TURNOS_E2E_KAFKA_CONSUMER_GROUP=