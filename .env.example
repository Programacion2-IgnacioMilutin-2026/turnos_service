# Copiar este archivo como .env y completar los valores. El archivo .env no se versiona.
# Lo leen docker compose y la aplicación (spring.config.import en application.yaml).
# Los valores van sin comillas: la aplicación toma las comillas como parte del valor.
TURNOS_DB_NAME=turnos
TURNOS_DB_USER=turnos
TURNOS_DB_PASSWORD=
TURNOS_DB_PORT=5432
# Clave privada RSA que firma el JWT de los usuarios. Generarla con los comandos de CLAUDE.md; secrets/ no se versiona.
TURNOS_JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem
# Vigencia del JWT (opcional, 24h por defecto). Formato de duración de Spring: 30m, 12h, 1d.
TURNOS_JWT_TOKEN_VALIDITY=24h
# Cuenta técnica de la cátedra (X01). Completar con los datos reales; si falta alguno, el servicio arranca
# con un warning y sin integración con la cátedra. Nunca subir estos valores al repositorio.
TURNOS_CATEDRA_BASE_URL=
TURNOS_CATEDRA_USERNAME=
TURNOS_CATEDRA_PASSWORD=
# Servicio de catálogo. Vacía: el servicio arranca con un warning y la consulta de turnos responde 503.
TURNOS_CATALOG_BASE_URL=
# Opcionales: tiempos y reintentos. Si no se definen, rigen los valores de abajo. Duraciones con el formato de Spring.
# Para cambiar uno, quitar el # y completar el valor; si queda vacía, rige el valor por defecto.
# TURNOS_CATALOG_CONNECT_TIMEOUT=2s
# TURNOS_CATALOG_READ_TIMEOUT=3s
# TURNOS_CATALOG_MAX_ATTEMPTS=3
# TURNOS_CATALOG_INITIAL_DELAY=500ms
# TURNOS_CATALOG_DELAY_MULTIPLIER=2
# TURNOS_CATEDRA_OPERATIONS_CONNECT_TIMEOUT=2s
# TURNOS_CATEDRA_OPERATIONS_READ_TIMEOUT=3s
# TURNOS_CATEDRA_OPERATIONS_MAX_ATTEMPTS=3
# TURNOS_CATEDRA_OPERATIONS_INITIAL_DELAY=500ms
# TURNOS_CATEDRA_OPERATIONS_DELAY_MULTIPLIER=2
# Opcionales: zona de atención (define "hoy" y qué turnos ya pasaron) y antigüedad máxima del caché de ocupaciones.
# TURNOS_ATTENTION_ZONE=America/Argentina/Mendoza
# TURNOS_OCCUPANCY_CACHE_MAX_AGE=60m
# Opcional: cuánto se espera después del vencimiento de un hold antes de dar el proceso de reserva por vencido.
# TURNOS_RESERVATION_SAFETY_MARGIN=30s
# Orígenes de navegador que pueden usar la API (CORS), separados por comas, por ejemplo http://localhost:3000.
# Vacío: ningún navegador. La app Android no lo necesita. No usar *
TURNOS_CORS_ALLOWED_ORIGINS=
